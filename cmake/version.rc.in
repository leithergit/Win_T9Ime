// Version resource, generated by t9_version_resource() (CMakeLists.txt) from
// project(VERSION) and the git commit; do not edit the generated copy.
#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@T9_BUILD_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@T9_BUILD_NUMBER@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @T9_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "T9Ime"
      VALUE "FileDescription", "@T9_FILE_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@.@T9_BUILD_NUMBER@"
      VALUE "InternalName", "@T9_INTERNAL_NAME@"
      VALUE "LegalCopyright", "Copyright (C) 2026 T9Ime. GPL-3.0"
      VALUE "OriginalFilename", "@T9_ORIGINAL_FILENAME@"
      VALUE "ProductName", "T9Ime 九宫格输入法"
      VALUE "ProductVersion", "@PROJECT_VERSION@.@T9_BUILD_NUMBER@ (@T9_COMMIT@)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
